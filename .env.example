# discrimen operator environment. Copy to .env and edit — docker compose reads
# .env from this directory automatically.
#
# READ THE LOG ON FIRST RUN. ROUTER_WORKER_TOKEN, ROUTER_CLIENT_TOKENS and
# ROUTER_ADMIN_PASSWORD are empty below. Left empty, the router generates a
# client key, a worker key and an admin password the first time it starts, and
# prints all three to its log — once, and never again:
#
#     docker compose logs discrimen | grep -i -A4 -E 'bootstrap|GENERATED'
#
# There are three banners, one per credential, and the secret sits three lines
# below its heading, so the -A4 is what actually prints them. Drop it and you
# match three headings and print nothing useful.
#
# Those generated credentials are ENFORCED. Miss the admin password and the way
# back in is to set ROUTER_ADMIN_PASSWORD below and restart, which resets it.
#
# The client and worker tokens are different: they are hashed and cannot be
# recovered, so issue a replacement through the admin API rather than trying to
# read them back. The router refuses to delete the last credential guarding a
# gate, so tidying the keys table cannot leave the door open by accident.
#
# Setting them here instead is the other supported path, and the one to use when
# something else already owns your secrets. Anything you set is accepted
# alongside the stored keys.

# ---------------------------------------------------------------------------
# router
# ---------------------------------------------------------------------------

# Port the router listens on. Change it when 8585 already belongs to something
# else on the host; compose maps host and container to the same number.
ROUTER_PORT=8585

# SQLite request log. Its directory is also where the tier adapter state and the
# generated persistence keyfile land, so this really decides where the durable
# data lives. The path is frozen for backwards compatibility with existing
# llm-router deployments — move it only if you move the volume with it.
LOG_DB_PATH=/data/llm-router/logs.sqlite

# Admin password, for the dashboard and the /admin API. Set it and it wins on
# every start, replacing whatever is stored — which is what makes it the recovery
# path when the generated one scrolled past. Leave it empty and a password
# rotated through the dashboard is left alone.
ROUTER_ADMIN_PASSWORD=

# Bearer token a worker must present to register itself. Empty until the router
# generates one on first run — after that a registration without a token is
# refused, so a worker that used to register against an open router needs the
# generated token adding to its config.
ROUTER_WORKER_TOKEN=

# Comma-separated bearer tokens accepted on the OpenAI surface. Issue one per
# caller so you can revoke a single client without disturbing the rest.
ROUTER_CLIENT_TOKENS=

# Encrypts stored endpoint API keys at rest. Leave it blank and the router
# generates a keyfile beside the log DB, which is the right answer for a single
# host; set it explicitly when several routers share one database, or when your
# backup strategy covers the DB but not the keyfile.
ROUTER_PERSIST_SECRET=

# How long request logs are kept. Raise it if you are mining history to explain
# routing decisions, lower it if the volume is filling.
LOG_RETENTION_DAYS=30

# Per-request body bytes kept in the log. Raise it when truncated prompts are
# making a routing decision hard to reconstruct; it is the main driver of DB
# growth.
LOG_MAX_BODY_BYTES=16384

# Seconds between backend health probes. Scales with fleet size — a large fleet
# on a short interval spends real time probing rather than serving.
HEALTH_INTERVAL_SECONDS=15

# Whole-exchange cap for a non-streaming request. Streaming ignores this and
# uses the idle watchdog below, so raise it for slow batch work rather than to
# fix a stalled stream.
BACKEND_TIMEOUT_SECONDS=600

# Streaming idle watchdog: give up after this many seconds with no token. 0
# disables it, which means a wedged backend holds the connection indefinitely.
BACKEND_IDLE_TIMEOUT_SECONDS=120

# How long a caller queues for a free slot before getting a 503. Lower it to
# shed load early, raise it if you would rather callers wait than retry.
ROUTER_SLOT_MAX_WAIT_SECONDS=600

# Applied when the client sends no max_tokens of its own. Too high wastes a slot
# on a runaway generation; too low truncates legitimate answers.
DEFAULT_MAX_TOKENS=4096

# One switch over difficulty scoring, thinking detection, online adaptation and
# judging. Off makes discrimen a plain load balancer and removes the embeddings
# worker dependency entirely — a reasonable choice if you want deterministic
# routing, not an optimisation.
ROUTER_AUTO_ROUTING=true

# ---------------------------------------------------------------------------
# embeddings worker
#
# Only needed while ROUTER_AUTO_ROUTING is true. The worker registers itself
# with the router; it is not configured on the router side.
# ---------------------------------------------------------------------------

# Port the worker listens on.
EMBEDDINGS_PORT=8586

# fastembed model. Changing it changes the vector space, so the router discards
# its cached difficulty scores and re-bootstraps its centroids.
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# Comma-separated bearer tokens for the worker's own /v1/embeddings surface.
# Empty leaves it open, which is usually right when only the router can reach it.
EMBEDDINGS_API_TOKENS=

# Where the worker finds the router to register with.
LLM_ROUTER_URL=http://discrimen:8585

# The URL THE ROUTER USES TO REACH THE WORKER — not the worker's own view of
# itself. Under compose that is the service name; localhost here means the
# router calling itself, which is the single most common way this setup fails.
LLM_WORKER_URL=http://discrimen-embeddings:8586

# Identity the worker registers under. Registering twice with one id replaces
# the entry rather than adding a second worker.
LLM_WORKER_ID=discrimen-embeddings

# Model name the router advertises for this worker.
LLM_WORKER_MODEL=bge-small-en-v1.5

# Feature flag the router looks for when it needs to embed a prompt. Anything
# other than `embeddings` and auto-routing will not find this worker.
LLM_WORKER_FEATURES=embeddings

# How long a registration stays valid without a keepalive. The worker
# re-registers every 60s, so this only matters for how long a dead worker
# lingers in the fleet.
LLM_WORKER_TTL_SECONDS=86400
