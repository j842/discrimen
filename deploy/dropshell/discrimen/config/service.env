SSH_USER="root"

# CONTAINER_NAME must stay "${SERVICE}" — do not hard-code it to "discrimen".
# This template replaces a service named llm-router, whose container is
# therefore llm-router and whose data volume is llm-router_data. That volume
# holds the SQLite database with the worker_profiles table: the cached
# cold-start profiles for the whole fleet. Renaming the container derives a
# different volume name, orphans the existing one, and re-benchmarks every
# worker from cold — hours of GPU time, and real money once paid endpoints are
# in the fleet. Deploy this template under the existing service name and the
# volume is picked up unchanged.
CONTAINER_NAME="${SERVICE}"
DATA_VOLUME="${CONTAINER_NAME}_data"

# ---- Deployment -------------------------------------------------------------

ROUTER_PORT=8585

# Frozen for backwards compatibility. The live database is at this path inside
# the data volume; pointing it at /data/discrimen/ starts an empty one and
# leaves every cached worker profile and every log row behind.
LOG_DB_PATH="/data/llm-router/logs.sqlite"

# ---- Auth -------------------------------------------------------------------
# All bearer tokens. Blank disables that check, which is only defensible while
# the port is unreachable from outside a trusted network.

# Dashboard login. Bootstrap only — the database is canonical once set, so
# changing this later does not rotate an already-stored password.
ROUTER_ADMIN_PASSWORD=""

# Single token, presented by workers when they register and unregister
# (POST /backends/register, DELETE /backends/{id}). Blank lets anything that
# can reach the port register itself as a worker.
ROUTER_WORKER_TOKEN=""

# Comma-separated client tokens, one per consuming service so each can be
# rotated on its own. Any token in the list authorises /v1/* and the read-only
# /backends, /workers and /logs endpoints.
ROUTER_CLIENT_TOKENS=""

# Encrypts stored endpoint API keys at rest. Blank means the router generates a
# key file (persist.key, 0600) beside the database instead — encryption is on
# either way. Keep whatever you set stable: change it and previously persisted
# keys cannot be decrypted, and those workers must re-register to restore them.
ROUTER_PERSIST_SECRET=""

# ---- Logging ----------------------------------------------------------------

# How long request/response rows are kept. A privacy decision, and it varies
# with who is calling you.
LOG_RETENTION_DAYS=30

# Cap on the stored body length per log row, so large prompts cannot grow the
# database without bound.
LOG_MAX_BODY_BYTES=16384

# ---- Timeouts ---------------------------------------------------------------

# Health poll interval across every registered worker. Scales with fleet size.
HEALTH_INTERVAL_SECONDS=15

# Whole-exchange cap for buffered (non-streaming) requests and probes.
# Streaming is deliberately not wall-clock capped — it is bounded by the idle
# watchdog below, so a legitimate multi-minute generation is never killed
# mid-stream.
BACKEND_TIMEOUT_SECONDS=600

# Streaming idle watchdog: abort when a backend sends no bytes at all, not even
# SSE heartbeats, for this long. This is what frees a hung worker's concurrency
# slot quickly instead of pinning it for the full BACKEND_TIMEOUT_SECONDS.
# 0 disables.
BACKEND_IDLE_TIMEOUT_SECONDS=120

# How long a caller queues for a slot before receiving a 503. A promise to
# clients, not a routing decision.
ROUTER_SLOT_MAX_WAIT_SECONDS=600

# ---- Request handling -------------------------------------------------------

# Token budget applied when a client declares none of its own.
#
# 16384, matching benchThinkMaxTokens in the cold-start benchmark. It used to be
# 4096, which meant ordinary traffic got a QUARTER of the budget this router's
# own benchmark considers necessary to grade a thinking model — and on a hybrid
# reasoning worker that is not a graceful cap. A thinking block cut off at the
# limit yields finish_reason=length with an EMPTY content field: no answer at
# all, not a short one. Measured 2026-08-20 on llm-6000pro-qwen38-27b-ninfer
# (Qwen3.8-27B), 48 requests at budget 4096: 4.2% came back empty, every one of
# them a counting question whose chain ran past 4096 tokens.
#
# This does NOT fix a true runaway — it converts the chains that would have
# concluded between 4k and 16k into answers, and makes the rest fail slower
# (~50s to ~3min of silence). The loop itself is being chased separately as a
# quantization question. Watch that trade on slow workers: at naples'
# ~10 tok/s an unbounded client now has a much longer worst case, bounded by
# ROUTER_SLOT_MAX_WAIT_SECONDS rather than by this.
DEFAULT_MAX_TOKENS=16384

# One switch for the whole automatic layer: difficulty classification, thinking
# mode, online adaptation and background judging. false turns discrimen into a
# plain load balancer and drops the hard dependency on the embeddings worker.
ROUTER_AUTO_ROUTING=true
