# DO NOT EDIT THIS FILE FOR YOUR SERVICE!
# This file is replaced from the template whenever there is an update.
# Edit the service.env file to make changes.

REQUIRES_HOST_ROOT=false
REQUIRES_DOCKER=true
REQUIRES_DOCKER_ROOT=false

# Multi-arch image published to ghcr.io by GitHub Actions. The target host
# pulls it; it never builds. No Go toolchain on the host, and every host runs
# the byte-identical binary.
IMAGE_REGISTRY="ghcr.io"
IMAGE_REPO="j842/discrimen"
IMAGE_TAG="latest"

# start.sh converges the container onto the requested image and run command, so
# an install that changes neither leaves the router serving. Skipping the
# uninstall step keeps it up while the template files are swapped underneath.
IDEMPOTENT=true

# Nothing about routing is configured here any more. Tier bands, classifier
# thresholds, adaptation rates and session behaviour are constants in the
# binary: the router derives what it needs from the fleet it measures, and an
# operator who has to set them has been handed the problem the router exists to
# solve. See config/service.env for the fourteen variables that survived.
